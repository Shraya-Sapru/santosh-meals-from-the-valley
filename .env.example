# Course key path (recommended): used with model gpt-6-luna via Portkey.
# The grading staff's .env (one folder above this repo) already has this set.
PORTKEY_API_KEY=

# Alternative: your own OpenAI key instead of the course key.
# If you set this, you must also set OPENAI_MODEL below.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: password for /admin/*. If unset, a documented default is used
# (see README) — not required for the staff to run the public app.
ADMIN_PASSWORD=
